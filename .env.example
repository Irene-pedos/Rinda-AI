# Copy to .env with: powershell -ExecutionPolicy Bypass -File scripts\new-env.ps1
# That script replaces every __GENERATE__ with a new random value.
# .env is ignored by Git. Never commit real secrets.

# Local MySQL 8 (port 3307, so it can sit next to XAMPP on 3306)
MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin
MYSQL_ROOT_PASSWORD=__GENERATE__
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=rinda
DB_USERNAME=rinda
DB_PASSWORD=__GENERATE__

# Backend
JAVA_17_HOME=C:\Program Files\Java\jdk-17
JWT_SECRET=__GENERATE__
BACKEND_URL=http://localhost:8080

# Key the ML service uses to post to /api/v1/internal/ml/results
ML_INTERNAL_API_KEY=__GENERATE__

# ML service
ML_SERVICE_URL=http://localhost:8000
# Google Cloud project registered for Earth Engine. Empty until the team has one.
GEE_PROJECT_ID=

# Optional (uncomment to change)
# Private folder for evidence photos, relative to backend/. Ignored by git.
# RINDA_UPLOADS_DIR=../uploads
# Automatic "Run analysis" every 5 days. Off by default: the MVP runs it by hand.
# RINDA_ANALYSIS_CRON=0 0 4 */5 * *
