<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Photos are optional (problem reports), so phones without a camera can still install the app -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".RindaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rinda"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Splash Launcher Screen -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Rinda.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding & Auth Flow -->
        <activity
            android:name=".ui.auth.LanguageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.ConsentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.VerifyOtpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Bottom Tabs Shell -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <!-- Plots Activities -->
        <activity
            android:name=".ui.plots.RegisterPlotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.plots.PlotDetailActivity"
            android:exported="false" />

        <!-- Claims Activities -->
        <activity
            android:name=".ui.claims.ClaimDetailActivity"
            android:exported="false" />

        <!-- Problem Report Activity -->
        <activity
            android:name=".ui.plots.ReportProblemActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Payout Account Activity -->
        <activity
            android:name=".ui.profile.PayoutAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Agent Activities -->
        <activity
            android:name=".ui.agent.VerifyPlotActivity"
            android:exported="false" />
        <activity
            android:name=".ui.agent.FieldVisitActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lets the camera app save the field-check photo into the app's private cache (never a public folder). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
