<?xml version="1.0" encoding="utf-8"?>
<!-- Rinda spacing, size and shape tokens. Use these, never raw dp values, in layouts. -->
<resources>
    <!-- Spacing (4dp grid) -->
    <dimen name="spacing_xxs">2dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">12dp</dimen>
    <dimen name="spacing_base">16dp</dimen>
    <dimen name="spacing_lg">20dp</dimen>
    <dimen name="spacing_xl">24dp</dimen>
    <dimen name="spacing_xxl">32dp</dimen>
    <dimen name="spacing_3xl">48dp</dimen>

    <!-- Screen layout -->
    <dimen name="screen_padding">20dp</dimen>
    <dimen name="card_padding">16dp</dimen>
    <dimen name="card_gap">12dp</dimen>
    <dimen name="section_gap">24dp</dimen>
    <dimen name="list_bottom_space">96dp</dimen>

    <!-- Touch targets (spec §5.3: at least 48dp) -->
    <dimen name="min_touch_target">48dp</dimen>
    <dimen name="button_height">56dp</dimen>
    <dimen name="row_height">64dp</dimen>

    <!-- Icons -->
    <dimen name="icon_sm">18dp</dimen>
    <dimen name="icon_md">24dp</dimen>
    <dimen name="icon_lg">32dp</dimen>
    <dimen name="icon_badge">44dp</dimen>
    <dimen name="icon_hero">72dp</dimen>
    <dimen name="illustration">160dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">14dp</dimen>
    <dimen name="radius_lg">20dp</dimen>
    <dimen name="radius_xl">28dp</dimen>
    <dimen name="radius_full">999dp</dimen>

    <!-- Elevation: cards are flat with a 1dp outline; only floating things are raised -->
    <dimen name="elevation_none">0dp</dimen>
    <dimen name="elevation_low">2dp</dimen>
    <dimen name="elevation_high">6dp</dimen>
    <dimen name="stroke_thin">1dp</dimen>
    <dimen name="stroke_selected">2dp</dimen>

    <!-- Charts -->
    <dimen name="chart_height_lg">220dp</dimen>
    <dimen name="chart_height_md">170dp</dimen>
</resources>
