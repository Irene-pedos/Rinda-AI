<?xml version="1.0" encoding="utf-8"?>
<!--
    Rinda design tokens (light). Every colour used in a layout or in Java must come from this file.
    The same names are redefined in values-night/colors.xml, so screens get dark mode for free.
    Never hard-code a hex value in a layout or in Java, and never use the old *_light / *_dark names.
    See docs/ANDROID_UI_GUIDELINES.md.
-->
<resources>
    <!-- Brand: maize-leaf green (primary actions, selected states) -->
    <color name="rinda_primary">#1E6B3C</color>
    <color name="rinda_on_primary">#FFFFFF</color>
    <color name="rinda_primary_container">#CDEBD4</color>
    <color name="rinda_on_primary_container">#06311A</color>

    <!-- Brand: harvest gold (highlights, area numbers, the forecast) -->
    <color name="rinda_secondary">#8A5A00</color>
    <color name="rinda_on_secondary">#FFFFFF</color>
    <color name="rinda_secondary_container">#FFE3A8</color>
    <color name="rinda_on_secondary_container">#2C1C00</color>
    <color name="rinda_accent">#F2B33D</color>

    <!-- Brand: rain blue (weather, rainfall) -->
