<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Android 12+: the system launch screen. Solid primary green, the white symbol with no tile
        around it, then Theme.Rinda.Splash continues on the same green, so there is no jump.
        Same items as values-v27/themes.xml plus the splash-screen ones.
    -->
    <style name="Theme.Rinda.Splash" parent="Theme.Rinda">
        <item name="android:windowBackground">@color/rinda_hero_start</item>
        <item name="android:statusBarColor">@color/rinda_hero_start</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/rinda_hero_start</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/rinda_hero_start</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/rinda_hero_start</item>
    </style>
</resources>
