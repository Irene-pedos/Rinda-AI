<?xml version="1.0" encoding="utf-8"?>
<!-- 2-step wizard for configuring simulated mobile money payout account per ANDROID_UI_GUIDELINES.md §7.2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rinda_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_close"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/payout_account_title" />

    <!-- Step Progress Header -->
    <LinearLayout
        android:id="@+id/stepHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/stepProgress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="2"
            android:progress="1"
            app:indicatorColor="@color/rinda_primary"
            app:trackColor="@color/rinda_outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_xs">

            <TextView
                android:id="@+id/tvStepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Rinda.Caption"
                tools:text="Step 1 of 2" />

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Rinda.Headline"
                tools:text="Choose provider" />
        </LinearLayout>
    </LinearLayout>

    <!-- Wizard Steps Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: Provider & Phone -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/stepProvider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_base">

                <!-- Academic Simulated Notice Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rinda.Card.Demo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            style="@style/Widget.Rinda.IconBadge"
                            android:backgroundTint="@color/status_demo_bg"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/status_demo" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:text="@string/payout_simulated_notice"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:textColor="@color/status_demo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="@string/payout_provider_caption"
                    android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />

                <!-- Card 1: MTN MoMo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProviderMomo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            style="@style/Widget.Rinda.IconBadge"
                            android:backgroundTint="@color/rinda_secondary_container"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/rinda_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/payout_provider_momo"
                                android:textAppearance="@style/TextAppearance.Rinda.Title" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:text="MTN Mobile Money account (*182#)"
                                android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivCheckMomo"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check"
                            app:tint="@color/rinda_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Airtel Money -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProviderAirtel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            style="@style/Widget.Rinda.IconBadge"
                            android:backgroundTint="@color/status_at_risk_bg"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/rinda_error" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/payout_provider_airtel"
                                android:textAppearance="@style/TextAppearance.Rinda.Title" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:text="Airtel Money account (*500#)"
                                android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivCheckAirtel"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check"
                            app:tint="@color/rinda_primary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Phone input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:hint="@string/payout_phone_label"
                    app:placeholderText="@string/payout_phone_hint"
                    app:helperText="@string/payout_name_match_notice"
                    app:startIconDrawable="@drawable/ic_phone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        style="@style/Rinda.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="phone"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Step 2: Verify OTP -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/stepOtp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_base">

                <TextView
                    android:id="@+id/tvOtpSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.Rinda.Body"
                    tools:text="Enter the 6-digit code sent to +250 780 000 001" />

                <!-- Dev Hint -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/otp_dev_hint"
                    android:textAppearance="@style/TextAppearance.Rinda.Caption"
                    android:textColor="@color/rinda_secondary" />

                <!-- 6-digit input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:hint="@string/otp_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOtpCode"
                        style="@style/Rinda.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="smsOTPCode"
                        android:gravity="center"
                        android:inputType="number"
                        android:letterSpacing="0.3"
                        android:maxLength="6"
                        android:textSize="24sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Resend countdown -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResendOtp"
                    style="@style/Widget.Rinda.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_base"
                    android:text="@string/resend_code" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Step 3: Success Screen -->
        <LinearLayout
            android:id="@+id/stepSuccess"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivSuccessBadge"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/rinda_primary"
                android:padding="20dp"
                android:src="@drawable/ic_check"
                app:tint="@color/rinda_on_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/payout_success_title"
                android:textAppearance="@style/TextAppearance.Rinda.Headline" />

            <TextView
                android:id="@+id/tvSuccessBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/payout_success_body"
                android:textAppearance="@style/TextAppearance.Rinda.Body"
                android:textColor="@color/rinda_text_secondary" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Bar (Progress + Back + Next) -->
    <LinearLayout
        style="@style/Rinda.BottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Rinda.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/btn_back"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/btn_send_payout_otp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />
    </LinearLayout>

</LinearLayout>