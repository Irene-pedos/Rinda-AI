<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_light"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="Claim Details"
            app:titleTextColor="@color/text_primary_light" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_base">

                <!-- Demo Notice Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDemoNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF3E0"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:strokeColor="#FFE0B2"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/spacing_md"
                        android:text="@string/demo_mode_warning"
                        android:textColor="#E65100"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Claim Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/outline_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_base">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPlotName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/text_primary_light"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="Hillside Field" />

                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/ic_status_pending_bg"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/status_pending"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="UNDER REVIEW" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTriggerDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="13sp"
                            tools:text="Triggered on: Oct 20, 2026" />

                        <TextView
                            android:id="@+id/tvSeason"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="12sp"
                            tools:text="Season: 2026A" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Status Stepper / Tracker Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/outline_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_base">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Claim Lifecycle"
                            android:textColor="@color/text_primary_light"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- 3 Step Horizontal Stepper -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Step 1: Triggered -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/ivStep1"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_status_healthy" />

                                <TextView
                                    android:id="@+id/tvStep1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center"
                                    android:text="Triggered"
                                    android:textColor="@color/rinda_green"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:id="@+id/lineStep1to2"
                                android:layout_width="32dp"
                                android:layout_height="2dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/rinda_green" />

                            <!-- Step 2: Assessment -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/ivStep2"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_status_pending" />

                                <TextView
                                    android:id="@+id/tvStep2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center"
                                    android:text="Assessment"
                                    android:textColor="@color/status_pending"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:id="@+id/lineStep2to3"
                                android:layout_width="32dp"
                                android:layout_height="2dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/outline_light" />

                            <!-- Step 3: Payout -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/ivStep3"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_status_no_data" />

                                <TextView
                                    android:id="@+id/tvStep3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center"
                                    android:text="Payout"
                                    android:textColor="@color/text_secondary_light"
                                    android:textSize="11sp" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Payout Amount Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rinda_green_container"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_base">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated Payout"
                            android:textColor="@color/rinda_green_on_container"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPayoutAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/rinda_green_on_container"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="100,000 RWF" />

                        <TextView
                            android:id="@+id/tvPayoutRateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/rinda_green_on_container"
                            android:textSize="13sp"
                            tools:text="40% of confirmed sum insured" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="* Payouts are simulated for academic demonstration. No real currency is transferred."
                            android:textColor="@color/rinda_green_on_container"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- "Why This Decision?" / Evidence Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/outline_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_base">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/why_decision_title"
                            android:textColor="@color/text_primary_light"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Satellite & Weather Evidence Section -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="@string/evidence_snapshot_title"
                            android:textColor="@color/rinda_green"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEvidenceDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/text_primary_light"
                            android:textSize="13sp"
                            tools:text="• Persistent low NDVI below the 10th percentile for 12 days\n• Cumulative rainfall: 45% of 30-day baseline during flowering\n• Anomaly score: -1.2 standard deviations" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:background="@color/outline_light" />

                        <!-- Officer Assessment Section -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/officer_reason_label"
                            android:textColor="@color/text_primary_light"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOfficerAssessment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="13sp"
                            tools:text="Officer Jean confirmed severe water deficit during field inspection. Satellite data trajectory corroborated localized drought loss." />

                        <TextView
                            android:id="@+id/tvOfficerDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="11sp"
                            tools:text="Decided: Oct 22, 2026" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Review Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/outline_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_base">

                        <TextView
                            android:id="@+id/tvReviewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ask_review_title"
                            android:textColor="@color/text_primary_light"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReviewSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="If you believe localized conditions or slope drainage affected your maize crop differently from the regional assessment, you can request an officer review."
                            android:textColor="@color/text_secondary_light"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAskReview"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/btn_height"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="@string/btn_request_review"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/rinda_green"
                            app:cornerRadius="@dimen/radius_md" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>