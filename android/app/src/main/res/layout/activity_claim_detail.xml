<?xml version="1.0" encoding="utf-8"?>
<!--
    Claim detail (spec §9.5): status + what it means, progress tracker, payout,
    "Why this decision?" (evidence + officer reason), and "Ask for a review".
    Claim status always comes from the server; the phone never changes it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/nav_claims" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_xxl">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDemoNotice"
                    style="@style/Widget.Rinda.Card.Demo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md">

                        <TextView style="@style/Widget.Rinda.Tag.Demo" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/demo_mode_warning"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:textColor="@color/status_demo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Header -->
                <TextView
                    android:id="@+id/tvPlotName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Rinda.Display" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTriggerDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/spacing_xs"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                        app:drawableStartCompat="@drawable/ic_calendar"
                        app:drawableTint="@color/rinda_text_tertiary" />

                    <TextView
                        android:id="@+id/tvSeason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_base"
                        android:textAppearance="@style/TextAppearance.Rinda.Caption" />
                </LinearLayout>

                <!-- Status + meaning -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rinda.Card.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            style="@style/Widget.Rinda.StatusPill"
                            android:accessibilityLiveRegion="polite" />

                        <TextView
                            android:id="@+id/tvStatusMeaning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textAppearance="@style/TextAppearance.Rinda.Body"
                            android:textColor="@color/rinda_text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Progress tracker -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/spacing_xs">

                        <include
                            android:id="@+id/progressHeader"
                            layout="@layout/view_card_header" />

                        <include
                            android:id="@+id/step1"
                            layout="@layout/view_tracker_step"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm" />

                        <include
                            android:id="@+id/step2"
                            layout="@layout/view_tracker_step" />

                        <include
                            android:id="@+id/step3"
                            layout="@layout/view_tracker_step" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Payout -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <include
                            android:id="@+id/payoutHeader"
                            layout="@layout/view_card_header" />

                        <TextView
                            android:id="@+id/tvPayoutAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.Rinda.Headline" />

                        <TextView
                            android:id="@+id/tvPayoutRateText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:background="@drawable/bg_rounded"
                            android:backgroundTint="@color/status_demo_bg"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:gravity="center_vertical"
                            android:padding="@dimen/spacing_md"
                            android:text="@string/claim_simulated_notice"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:textColor="@color/status_demo"
                            app:drawableStartCompat="@drawable/ic_info"
                            app:drawableTint="@color/status_demo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Why this decision? -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <include
                            android:id="@+id/whyHeader"
                            layout="@layout/view_card_header" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:gravity="center_vertical"
                            android:text="@string/evidence_snapshot_title"
                            android:textAppearance="@style/TextAppearance.Rinda.Label"
                            app:drawableStartCompat="@drawable/ic_satellite"
                            app:drawableTint="@color/rinda_tertiary" />

                        <TextView
                            android:id="@+id/tvEvidenceDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.Rinda.Body" />

                        <View
                            style="@style/Rinda.Divider"
                            android:layout_marginTop="@dimen/spacing_base"
                            android:layout_marginBottom="@dimen/spacing_base" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:gravity="center_vertical"
                            android:text="@string/officer_reason_label"
                            android:textAppearance="@style/TextAppearance.Rinda.Label"
                            app:drawableStartCompat="@drawable/ic_nav_profile"
                            app:drawableTint="@color/rinda_primary" />

                        <TextView
                            android:id="@+id/tvOfficerAssessment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.Rinda.Body" />

                        <TextView
                            android:id="@+id/tvOfficerDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.Rinda.Caption"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ask for a review -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReview"
                    style="@style/Widget.Rinda.Card.Tinted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:id="@+id/tvReviewTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/ask_review_title"
                            android:textAppearance="@style/TextAppearance.Rinda.Title"
                            android:textColor="@color/rinda_on_primary_container" />

                        <TextView
                            android:id="@+id/tvReviewSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/ask_review_subtitle"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:textColor="@color/rinda_on_primary_container" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAskReview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="@string/btn_request_review"
                            app:icon="@drawable/ic_sync" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:gravity="center"
                            android:text="@string/ask_review_once"
                            android:textAppearance="@style/TextAppearance.Rinda.Caption"
                            android:textColor="@color/rinda_on_primary_container" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
