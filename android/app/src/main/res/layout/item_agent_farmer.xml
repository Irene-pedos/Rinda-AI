<?xml version="1.0" encoding="utf-8"?>
<!-- Farmer row card for Cooperative Agent per ANDROID_UI_GUIDELINES.md §7.3 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFarmer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <!-- Avatar Initials Circle -->
        <TextView
            android:id="@+id/tvAvatarInitials"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/rinda_secondary_container"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.Rinda.Subtitle"
            android:textColor="@color/rinda_on_secondary_container"
            tools:text="DF" />

        <!-- Farmer Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFarmerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Rinda.Title"
                tools:text="Demo Farmer One" />

            <TextView
                android:id="@+id/tvFarmerPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:drawablePadding="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                app:drawableStartCompat="@drawable/ic_phone"
                app:drawableTint="@color/rinda_text_tertiary"
                tools:text="+250 780 000 001" />

            <!-- Count Tags -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tagPlotsCount"
                    style="@style/Widget.Rinda.Tag"
                    android:backgroundTint="@color/rinda_surface_variant"
                    android:textColor="@color/rinda_text_secondary"
                    tools:text="3 plots" />

                <TextView
                    android:id="@+id/tagPendingCount"
                    style="@style/Widget.Rinda.Tag"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:backgroundTint="@color/status_pending_bg"
                    android:textColor="@color/status_pending"
                    tools:text="1 pending check" />

                <TextView
                    android:id="@+id/tagAtRiskCount"
                    style="@style/Widget.Rinda.Tag"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:backgroundTint="@color/status_at_risk_bg"
                    android:textColor="@color/status_at_risk"
                    android:visibility="gone"
                    tools:text="1 at risk" />
            </LinearLayout>

        </LinearLayout>

        <!-- Chevron -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/rinda_text_tertiary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
