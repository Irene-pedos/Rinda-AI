<?xml version="1.0" encoding="utf-8"?>
<!-- Plots tab: list of plot cards, a friendly empty state with one clear action, and an "Add a plot" button. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlots"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/list_rise"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/list_bottom_space" />

            <include
                android:id="@+id/layoutEmpty"
                layout="@layout/view_empty_state"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddPlot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:minHeight="@dimen/button_height"
        android:text="@string/btn_register_plot"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Rinda.Button"
        app:backgroundTint="@color/rinda_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/rinda_on_primary"
        android:textColor="@color/rinda_on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
