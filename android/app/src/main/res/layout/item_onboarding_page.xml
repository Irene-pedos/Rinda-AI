<?xml version="1.0" encoding="utf-8"?>
<!-- One onboarding slide: one big picture, one title, one or two short sentences. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl">

        <FrameLayout
            android:id="@+id/illustration"
            android:layout_width="@dimen/illustration"
            android:layout_height="@dimen/illustration"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/rinda_primary_container">

            <ImageView
                android:id="@+id/ivSlideImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_leaf"
                app:tint="@color/rinda_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSlideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Rinda.Headline" />

        <TextView
            android:id="@+id/tvSlideDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Rinda.Body" />
    </LinearLayout>
</ScrollView>
