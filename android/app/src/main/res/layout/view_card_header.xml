<?xml version="1.0" encoding="utf-8"?>
<!-- Card title with an icon and an optional "?" help button on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/min_touch_target"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivHeaderIcon"
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_leaf"
        app:tint="@color/rinda_primary" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Rinda.Title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHeaderHelp"
        style="@style/Widget.Rinda.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-8dp"
        android:contentDescription="@string/cd_help"
        android:visibility="gone"
        app:icon="@drawable/ic_help" />
</LinearLayout>
