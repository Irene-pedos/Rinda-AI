<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up (new phone numbers only): name + cooperative. Farmers only (spec §2.2 #3). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <ImageView
                style="@style/Widget.Rinda.IconBadge"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:src="@drawable/ic_nav_profile" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:accessibilityHeading="true"
                android:text="@string/signup_title"
                android:textAppearance="@style/TextAppearance.Rinda.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/signup_subtitle"
                android:textAppearance="@style/TextAppearance.Rinda.Body" />

            <TextView
                style="@style/Widget.Rinda.Tag"
                android:layout_marginTop="@dimen/spacing_md"
                android:backgroundTint="@color/rinda_primary_container"
                android:drawablePadding="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:text="@string/signup_account_type"
                android:textColor="@color/rinda_on_primary_container"
                app:drawableStartCompat="@drawable/ic_leaf"
                app:drawableTint="@color/rinda_on_primary_container" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:hint="@string/full_name_label"
                app:helperText="@string/full_name_helper"
                app:helperTextEnabled="true"
                app:placeholderText="@string/full_name_hint"
                app:startIconDrawable="@drawable/ic_nav_profile">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    style="@style/Rinda.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCooperative"
                style="@style/Widget.Rinda.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_base"
                android:hint="@string/cooperative_label"
                app:helperText="@string/cooperative_loading"
                app:helperTextEnabled="true"
                app:startIconDrawable="@drawable/ic_group">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actCooperative"
                    style="@style/Rinda.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout style="@style/Rinda.BottomBar">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleteSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_complete_signup" />
    </LinearLayout>
</LinearLayout>
