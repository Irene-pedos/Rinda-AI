<?xml version="1.0" encoding="utf-8"?>
<!-- "Label ............ Value" row with an icon. Used in review screens and detail cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_height"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivRowIcon"
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info"
        app:tint="@color/rinda_text_tertiary" />

    <TextView
        android:id="@+id/tvRowLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:textAppearance="@style/TextAppearance.Rinda.Body" />

    <TextView
        android:id="@+id/tvRowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Rinda.Subtitle" />
</LinearLayout>
