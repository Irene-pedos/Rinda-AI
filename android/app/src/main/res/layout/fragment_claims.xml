<?xml version="1.0" encoding="utf-8"?>
<!-- Claims tab: an explanation of automatic claims (with help), then the list or an empty state. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClaimsInfo"
            style="@style/Widget.Rinda.Card.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/screen_padding"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    style="@style/Widget.Rinda.IconBadge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_shield" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/claims_info"
                    android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                    android:textColor="@color/rinda_text_primary" />

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:contentDescription="@string/cd_help"
                    android:src="@drawable/ic_help" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvClaims"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/list_rise"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_xl" />

            <include
                android:id="@+id/layoutEmpty"
                layout="@layout/view_empty_state"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
