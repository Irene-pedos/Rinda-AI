<?xml version="1.0" encoding="utf-8"?>
<!-- One text field inside a dialog (rename plot, server address). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing_xl"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_xl">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInput"
            style="@style/Rinda.InputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="200" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
