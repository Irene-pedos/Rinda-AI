<?xml version="1.0" encoding="utf-8"?>
<!--
    Register a plot in 3 steps (spec §9.4): 1 draw the field, 2 name + planting date, 3 check and send,
    then a success screen that says what happens next ("Waiting for check").
    Only one step is visible at a time; Back / Next stay at the bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/btn_register_plot" />

    <!-- Step header -->
    <LinearLayout
        android:id="@+id/stepHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_md">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/stepProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:progress="1"
            app:trackColor="@color/rinda_outline"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.Rinda.Caption" />

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Rinda.Headline" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== Step 1: draw ===== -->
        <FrameLayout
            android:id="@+id/stepDraw"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_map" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="@dimen/spacing_md"
                app:cardElevation="@dimen/elevation_high"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm">

                    <ImageView
                        style="@style/Widget.Rinda.IconBadge"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_touch" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/draw_boundary_instruction"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:textColor="@color/rinda_text_primary" />

                        <TextView
                            android:id="@+id/tvPointCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.Rinda.Label"
                            android:textColor="@color/rinda_primary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDrawHelp"
                        style="@style/Widget.Rinda.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cd_help"
                        app:icon="@drawable/ic_help" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvEstimatedArea"
                    style="@style/Widget.Rinda.Tag"
                    android:layout_height="@dimen/min_touch_target"
                    android:backgroundTint="@color/rinda_surface"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:elevation="@dimen/elevation_low"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:textAppearance="@style/TextAppearance.Rinda.Label"
                    android:textColor="@color/rinda_secondary"
                    app:drawableStartCompat="@drawable/ic_area"
                    app:drawableTint="@color/rinda_secondary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUndoPoint"
                    style="@style/Widget.Rinda.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:elevation="@dimen/elevation_low"
                    android:paddingStart="@dimen/spacing_base"
                    android:paddingEnd="@dimen/spacing_base"
                    android:text="@string/draw_undo"
                    app:backgroundTint="@color/rinda_surface"
                    app:icon="@drawable/ic_undo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearPoints"
                    style="@style/Widget.Rinda.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="@dimen/elevation_low"
                    android:paddingStart="@dimen/spacing_base"
                    android:paddingEnd="@dimen/spacing_base"
                    android:text="@string/draw_clear"
                    android:textColor="@color/rinda_error"
                    app:backgroundTint="@color/rinda_surface"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/rinda_error" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Step 2: details ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/stepDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPlotName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/plot_name_label"
                    app:helperText="@string/plot_name_helper"
                    app:helperTextEnabled="true"
                    app:placeholderText="@string/plot_name_hint"
                    app:startIconDrawable="@drawable/ic_edit">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPlotName"
                        style="@style/Rinda.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="80" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPlantingDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:hint="@string/planting_date_label"
                    app:endIconContentDescription="@string/cd_help"
                    app:endIconDrawable="@drawable/ic_help"
                    app:endIconMode="custom"
                    app:helperText="@string/planting_date_helper"
                    app:helperTextEnabled="true"
                    app:startIconDrawable="@drawable/ic_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPlantingDate"
                        style="@style/Rinda.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="@string/planting_date_hint"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Crop is fixed: maize only (spec §0 rule 1). Not a picker. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rinda.Card.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/row_height"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            style="@style/Widget.Rinda.IconBadge"
                            android:src="@drawable/ic_leaf" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/crop_label"
                                android:textAppearance="@style/TextAppearance.Rinda.Caption" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/crop_maize"
                                android:textAppearance="@style/TextAppearance.Rinda.Subtitle" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/rinda_text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Step 3: review ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/stepReview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingBottom="@dimen/spacing_xs">

                        <include
                            android:id="@+id/rowName"
                            layout="@layout/view_detail_row" />

                        <View style="@style/Rinda.Divider" />

                        <include
                            android:id="@+id/rowArea"
                            layout="@layout/view_detail_row" />

                        <View style="@style/Rinda.Divider" />

                        <include
                            android:id="@+id/rowPlanting"
                            layout="@layout/view_detail_row" />

                        <View style="@style/Rinda.Divider" />

                        <include
                            android:id="@+id/rowCrop"
                            layout="@layout/view_detail_row" />

                        <View style="@style/Rinda.Divider" />

                        <include
                            android:id="@+id/rowCorners"
                            layout="@layout/view_detail_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rinda.Card.Tinted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <include
                        android:id="@+id/nextInfo"
                        layout="@layout/view_icon_point"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/card_padding" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Success ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/stepSuccess"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xxl">

                <FrameLayout
                    android:id="@+id/successBadge"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/status_healthy_bg">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_status_healthy"
                        app:tint="@color/status_healthy" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:text="@string/register_success_title"
                    android:textAppearance="@style/TextAppearance.Rinda.Headline" />

                <TextView
                    android:id="@+id/tvSuccessBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Rinda.Body" />

                <TextView
                    android:id="@+id/tvSuccessStatus"
                    style="@style/Widget.Rinda.StatusPill"
                    android:layout_marginTop="@dimen/spacing_base" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_base"
                    android:gravity="center"
                    android:text="@string/register_success_next"
                    android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        style="@style/Rinda.BottomBar">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Rinda.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_weight="1"
                android:text="@string/btn_back"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/btn_next"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
