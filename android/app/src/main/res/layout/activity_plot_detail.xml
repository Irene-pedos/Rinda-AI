<?xml version="1.0" encoding="utf-8"?>
<!--
    Plot detail (spec §9.4). Order = what the farmer cares about first:
    1 plot header + verification, 2 crop health (+ meaning, what to do, confidence),
    3 harvest forecast, 4 insurance cover, 5 charts, 6 manage.
    Health alerts open this screen; claim updates never do (spec §2.2 #7).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/plot_detail_title">

        <TextView
            android:id="@+id/tvHeaderDemoBadge"
            style="@style/Widget.Rinda.Tag.Demo"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/spacing_base"
            android:visibility="gone" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_xxl">

                <!-- 1. Header -->
                <TextView
                    android:id="@+id/tvPlotName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Rinda.Display" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/spacing_xs"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Rinda.Label"
                        android:textColor="@color/rinda_secondary"
                        app:drawableStartCompat="@drawable/ic_area"
                        app:drawableTint="@color/rinda_secondary" />

                    <TextView
                        android:id="@+id/tvPlantingDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_base"
                        android:drawablePadding="@dimen/spacing_xs"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                        app:drawableStartCompat="@drawable/ic_calendar"
                        app:drawableTint="@color/rinda_text_tertiary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.Rinda.Caption"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rinda.Card.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tvVerificationText"
                            style="@style/Widget.Rinda.StatusPill" />

                        <TextView
                            android:id="@+id/tvVerificationMeaning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />

                        <TextView
                            android:id="@+id/tvLastUpdated"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Rinda.Caption"
                            android:textColor="@color/rinda_text_tertiary"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_sync"
                            app:drawableTint="@color/rinda_text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Crop health -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHealthStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <include
                            android:id="@+id/healthHeader"
                            layout="@layout/view_card_header" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivHealthIcon"
                                style="@style/Widget.Rinda.IconBadge"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:padding="14dp"
                                android:src="@drawable/ic_status_no_data" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHealthWord"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:accessibilityLiveRegion="polite"
                                    android:text="@string/health_not_analysed"
                                    android:textAppearance="@style/TextAppearance.Rinda.Headline" />

                                <TextView
                                    android:id="@+id/tvHealthDate"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Rinda.Caption"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHealthMeaning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="@string/health_not_analysed_meaning"
                            android:textAppearance="@style/TextAppearance.Rinda.Body"
                            android:textColor="@color/rinda_text_primary" />

                        <TextView
                            android:id="@+id/tvCause"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textAppearance="@style/TextAppearance.Rinda.Subtitle"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvExplanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_weather_rain"
                            app:drawableTint="@color/rinda_tertiary" />

                        <!-- What you can do -->
                        <LinearLayout
                            android:id="@+id/layoutTodo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:background="@drawable/bg_rounded"
                            android:backgroundTint="@color/rinda_surface_variant"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_md"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_lightbulb"
                                app:tint="@color/rinda_secondary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_what_to_do"
                                    android:textAppearance="@style/TextAppearance.Rinda.Label" />

                                <TextView
                                    android:id="@+id/tvTodo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xxs"
                                    android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFieldVisit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:gravity="center_vertical"
                            android:text="@string/needs_field_visit"
                            android:textAppearance="@style/TextAppearance.Rinda.Label"
                            android:textColor="@color/status_watch"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_visit"
                            app:drawableTint="@color/status_watch" />

                        <LinearLayout
                            android:id="@+id/layoutConfidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvConfidenceBadge"
                                style="@style/Widget.Rinda.Tag"
                                android:backgroundTint="@color/rinda_surface_variant"
                                android:textColor="@color/rinda_text_secondary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConfidenceHelp"
                                style="@style/Widget.Rinda.IconButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/cd_help"
                                app:icon="@drawable/ic_help"
                                app:iconSize="@dimen/icon_sm" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDataQualityNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Rinda.Caption"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Harvest forecast: always a range, labelled as a prototype -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <include
                            android:id="@+id/forecastHeader"
                            layout="@layout/view_card_header" />

                        <TextView
                            android:id="@+id/tvHarvestForecastRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/harvest_pending"
                            android:textAppearance="@style/TextAppearance.Rinda.Headline"
                            android:textColor="@color/rinda_secondary" />

                        <TextView
                            android:id="@+id/tvForecastDisclaimer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:text="@string/harvest_forecast_disclaimer"
                            android:textAppearance="@style/TextAppearance.Rinda.Caption"
                            app:drawableStartCompat="@drawable/ic_info"
                            app:drawableTint="@color/rinda_text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Insurance cover (enrollment, spec §2.2 #5) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCoverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <include
                            android:id="@+id/coverageHeader"
                            layout="@layout/view_card_header" />

                        <TextView
                            android:id="@+id/tvEnrollmentStatus"
                            style="@style/Widget.Rinda.StatusPill"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/coverage_checking" />

                        <TextView
                            android:id="@+id/tvEnrollmentHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/rowSumInsured"
                            layout="@layout/view_detail_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5a. NDVI chart, labelled as crop health vs the normal band (spec §2.2 #8) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <include
                            android:id="@+id/ndviHeader"
                            layout="@layout/view_card_header" />

                        <TextView
                            android:id="@+id/tvNdviSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_ndvi_subtitle"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartNdvi"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/chart_height_lg"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:contentDescription="@string/chart_ndvi_title" />

                        <LinearLayout
                            android:id="@+id/layoutNotEnoughSatelliteData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="@color/status_not_enough_data_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg"
                            android:visibility="gone">

                            <ImageView
                                style="@style/Widget.Rinda.IconBadge"
                                android:backgroundTint="@color/status_not_enough_data"
                                android:src="@drawable/ic_satellite"
                                app:tint="@color/rinda_surface" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:gravity="center"
                                android:text="@string/health_not_enough_data"
                                android:textAppearance="@style/TextAppearance.Rinda.Title"
                                android:textColor="@color/status_not_enough_data" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:gravity="center"
                                android:text="@string/health_no_data_meaning"
                                android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:gravity="center"
                                android:text="@string/health_no_data_todo"
                                android:textAppearance="@style/TextAppearance.Rinda.Caption"
                                android:textColor="@color/rinda_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5b. Rain chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <include
                            android:id="@+id/rainHeader"
                            layout="@layout/view_card_header" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_rain_subtitle"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chartRain"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/chart_height_md"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:contentDescription="@string/chart_rain_title" />

                        <TextView
                            android:id="@+id/tvEmptyRain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:gravity="center"
                            android:padding="@dimen/spacing_lg"
                            android:text="@string/empty_rain_data"
                            android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                            android:textColor="@color/rinda_text_tertiary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Manage -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:accessibilityHeading="true"
                    android:text="@string/plot_manage_title"
                    android:textAppearance="@style/TextAppearance.Rinda.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportProblem"
                    style="@style/Widget.Rinda.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/btn_report_problem"
                    app:icon="@drawable/ic_camera" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPlot"
                    style="@style/Widget.Rinda.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_rename_plot"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeletePlot"
                    style="@style/Widget.Rinda.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/btn_delete_plot"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
