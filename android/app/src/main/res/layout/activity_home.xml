<?xml version="1.0" encoding="utf-8"?>
<!-- Main shell: header, offline banner, tab content, bottom navigation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/spacing_base">

        <!-- Rinda symbol: green in light mode, white in dark mode (drawable-night-nodpi) -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/rinda_logo_icon" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Rinda.Title"
            android:textSize="20sp" />

        <!-- Demo label on all is_demo data (spec §0 rule 4) -->
        <TextView
            android:id="@+id/tvDemoBadge"
            style="@style/Widget.Rinda.Tag.Demo"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvRoleBadge"
            style="@style/Widget.Rinda.Tag"
            android:backgroundTint="@color/rinda_primary_container"
            android:text="@string/role_farmer"
            android:textColor="@color/rinda_on_primary_container" />
    </LinearLayout>

    <!-- Offline banner: shown whenever there is no internet -->
    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_watch_bg"
        android:drawablePadding="@dimen/spacing_sm"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/offline_banner"
        android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
        android:textColor="@color/status_watch"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite"
        app:drawableStartCompat="@drawable/ic_offline"
        app:drawableTint="@color/status_watch" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
