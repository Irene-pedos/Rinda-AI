<?xml version="1.0" encoding="utf-8"?>
<!-- Plot card: name, status pill (icon + word), area and planting date. The whole card opens the plot. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_sm"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <ImageView
            android:id="@+id/ivPlotBadge"
            style="@style/Widget.Rinda.IconBadge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:src="@drawable/ic_leaf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlotName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Rinda.Title" />

                <TextView
                    android:id="@+id/tvPlotDemoBadge"
                    style="@style/Widget.Rinda.Tag.Demo"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusWord"
                style="@style/Widget.Rinda.StatusPill"
                android:layout_marginTop="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Rinda.Label"
                    android:textColor="@color/rinda_secondary"
                    app:drawableStartCompat="@drawable/ic_area"
                    app:drawableTint="@color/rinda_secondary" />

                <TextView
                    android:id="@+id/tvPlantingDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                    app:drawableStartCompat="@drawable/ic_calendar"
                    app:drawableTint="@color/rinda_text_tertiary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgentVerify"
                style="@style/Widget.Rinda.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/btn_verify_plot_boundary"
                android:visibility="gone"
                app:icon="@drawable/ic_check" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginStart="@dimen/spacing_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
