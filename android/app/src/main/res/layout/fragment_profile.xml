<?xml version="1.0" encoding="utf-8"?>
<!-- Profile: who you are, settings as big tappable rows, help, and log out (destructive, at the bottom). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_xxl">

        <!-- Who you are -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/rinda_primary"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.Rinda.Headline"
                    android:textColor="@color/rinda_on_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_base"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProfileName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Rinda.Title" />

                        <ImageButton
                            android:id="@+id/btnEditName"
                            style="@style/Widget.Rinda.IconButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/profile_edit_name"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/rinda_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:drawablePadding="@dimen/spacing_xs"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Rinda.BodySmall"
                        app:drawableStartCompat="@drawable/ic_phone"
                        app:drawableTint="@color/rinda_text_tertiary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProfileRole"
                            style="@style/Widget.Rinda.Tag"
                            android:backgroundTint="@color/rinda_primary_container"
                            android:text="@string/role_farmer"
                            android:textColor="@color/rinda_on_primary_container" />

                        <TextView
                            android:id="@+id/tvProfileDemo"
                            style="@style/Widget.Rinda.Tag.Demo"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:accessibilityHeading="true"
            android:text="@string/profile_settings"
            android:textAppearance="@style/TextAppearance.Rinda.Section" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowPayout"
                    layout="@layout/view_settings_row" />

                <View
                    style="@style/Rinda.Divider"
                    android:layout_marginStart="68dp" />

                <include
                    android:id="@+id/rowSmsAlerts"
                    layout="@layout/view_settings_row" />

                <View
                    style="@style/Rinda.Divider"
                    android:layout_marginStart="68dp" />

                <include
                    android:id="@+id/rowLanguage"
                    layout="@layout/view_settings_row" />

                <View
                    style="@style/Rinda.Divider"
                    android:layout_marginStart="68dp" />

                <include
                    android:id="@+id/rowHelp"
                    layout="@layout/view_settings_row" />

                <View
                    style="@style/Rinda.Divider"
                    android:layout_marginStart="68dp" />

                <include
                    android:id="@+id/rowPrivacy"
                    layout="@layout/view_settings_row" />

                <View
                    style="@style/Rinda.Divider"
                    android:layout_marginStart="68dp" />

                <include
                    android:id="@+id/rowServer"
                    layout="@layout/view_settings_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Rinda.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/btn_logout"
            app:icon="@drawable/ic_logout" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Rinda.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
