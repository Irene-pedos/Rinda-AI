<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding page dots: wide pill when selected, small dot otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rinda_primary" />
            <corners android:radius="@dimen/radius_full" />
            <size android:width="24dp" android:height="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rinda_outline_strong" />
            <corners android:radius="@dimen/radius_full" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
</selector>
